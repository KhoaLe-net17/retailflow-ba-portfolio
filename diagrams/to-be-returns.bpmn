<bpmn:process id="Process_to_be_returns" name="Proposed return handling · policy 0.1" isExecutable="false"><bpmn:documentation>Fictional analysis model; not deployed automation. Cancellation before inspection is a separate supported alternate flow documented in state-models.md.</bpmn:documentation><bpmn:laneSet id="LaneSet"><bpmn:lane id="Lane_0" name="Customer service / system"><bpmn:flowNodeRef>start</bpmn:flowNodeRef><bpmn:flowNodeRef>validate</bpmn:flowNodeRef><bpmn:flowNodeRef>eligible</bpmn:flowNodeRef><bpmn:flowNodeRef>reject</bpmn:flowNodeRef><bpmn:flowNodeRef>end_invalid</bpmn:flowNodeRef><bpmn:flowNodeRef>reserve</bpmn:flowNodeRef><bpmn:flowNodeRef>approval</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_1" name="Manager"><bpmn:flowNodeRef>review</bpmn:flowNodeRef><bpmn:flowNodeRef>decision</bpmn:flowNodeRef><bpmn:flowNodeRef>release</bpmn:flowNodeRef><bpmn:flowNodeRef>end_reject</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_2" name="Store operations"><bpmn:flowNodeRef>inspect</bpmn:flowNodeRef><bpmn:flowNodeRef>accepted</bpmn:flowNodeRef><bpmn:flowNodeRef>dispute</bpmn:flowNodeRef><bpmn:flowNodeRef>end_dispute</bpmn:flowNodeRef><bpmn:flowNodeRef>amount</bpmn:flowNodeRef><bpmn:flowNodeRef>end</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet><bpmn:startEvent id="start" name="Request entered"><bpmn:outgoing>Flow_0</bpmn:outgoing></bpmn:startEvent><bpmn:serviceTask id="validate" name="Validate policy and units"><bpmn:incoming>Flow_0</bpmn:incoming><bpmn:outgoing>Flow_1</bpmn:outgoing></bpmn:serviceTask><bpmn:exclusiveGateway id="eligible" name="Eligible?"><bpmn:incoming>Flow_1</bpmn:incoming><bpmn:outgoing>Flow_2</bpmn:outgoing><bpmn:outgoing>Flow_4</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:userTask id="reject" name="Explain eligibility rejection"><bpmn:incoming>Flow_2</bpmn:incoming><bpmn:outgoing>Flow_3</bpmn:outgoing></bpmn:userTask><bpmn:endEvent id="end_invalid" name="Not submitted"><bpmn:incoming>Flow_3</bpmn:incoming></bpmn:endEvent><bpmn:serviceTask id="reserve" name="Reserve units atomically"><bpmn:incoming>Flow_4</bpmn:incoming><bpmn:outgoing>Flow_5</bpmn:outgoing></bpmn:serviceTask><bpmn:exclusiveGateway id="approval" name="Exception review?"><bpmn:incoming>Flow_5</bpmn:incoming><bpmn:outgoing>Flow_6</bpmn:outgoing><bpmn:outgoing>Flow_10</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:userTask id="review" name="Independent approval decision"><bpmn:incoming>Flow_6</bpmn:incoming><bpmn:outgoing>Flow_7</bpmn:outgoing></bpmn:userTask><bpmn:exclusiveGateway id="decision" name="Approved?"><bpmn:incoming>Flow_7</bpmn:incoming><bpmn:outgoing>Flow_8</bpmn:outgoing><bpmn:outgoing>Flow_11</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:serviceTask id="release" name="Release units and record reason"><bpmn:incoming>Flow_8</bpmn:incoming><bpmn:outgoing>Flow_9</bpmn:outgoing></bpmn:serviceTask><bpmn:endEvent id="end_reject" name="Rejected"><bpmn:incoming>Flow_9</bpmn:incoming></bpmn:endEvent><bpmn:userTask id="inspect" name="Receive and inspect goods"><bpmn:incoming>Flow_10</bpmn:incoming><bpmn:incoming>Flow_11</bpmn:incoming><bpmn:outgoing>Flow_12</bpmn:outgoing></bpmn:userTask><bpmn:exclusiveGateway id="accepted" name="Accepted?"><bpmn:incoming>Flow_12</bpmn:incoming><bpmn:outgoing>Flow_13</bpmn:outgoing><bpmn:outgoing>Flow_15</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:userTask id="dispute" name="Quarantine and record discrepancy"><bpmn:incoming>Flow_13</bpmn:incoming><bpmn:outgoing>Flow_14</bpmn:outgoing></bpmn:userTask><bpmn:endEvent id="end_dispute" name="Disputed / payment blocked"><bpmn:incoming>Flow_14</bpmn:incoming></bpmn:endEvent><bpmn:serviceTask id="amount" name="Confirm reserved-unit paid value"><bpmn:incoming>Flow_15</bpmn:incoming><bpmn:outgoing>Flow_16</bpmn:outgoing></bpmn:serviceTask><bpmn:endEvent id="end" name="Accepted / ready for finance"><bpmn:incoming>Flow_16</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="Flow_0" sourceRef="start" targetRef="validate"/><bpmn:sequenceFlow id="Flow_1" sourceRe