<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_to-be-payments" targetNamespace="https://github.com/KhoaLe-net17/retailflow-ba-portfolio" exporter="RetailFlow BPMN source builder" exporterVersion="1.0.0">
<bpmn:process id="Process_to_be_payments" name="Proposed payment handling · policy 0.1" isExecutable="false"><bpmn:documentation>Fictional analysis model; not deployed automation. Cancellation before inspection is a separate supported alternate flow documented in state-models.md.</bpmn:documentation><bpmn:laneSet id="LaneSet"><bpmn:lane id="Lane_0" name="Finance / intake and failure review"><bpmn:flowNodeRef>start</bpmn:flowNodeRef><bpmn:flowNodeRef>submit</bpmn:flowNodeRef><bpmn:flowNodeRef>failed</bpmn:flowNodeRef><bpmn:flowNodeRef>end_failed</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_1" name="Reference payment system"><bpmn:flowNodeRef>validate</bpmn:flowNodeRef><bpmn:flowNodeRef>pay</bpmn:flowNodeRef><bpmn:flowNodeRef>outcome</bpmn:flowNodeRef><bpmn:flowNodeRef>success</bpmn:flowNodeRef><bpmn:flowNodeRef>end_ok</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_2" name="Finance / reconciliation"><bpmn:flowNodeRef>reconcile</bpmn:flowNodeRef><bpmn:flowNodeRef>confirmed</bpmn:flowNodeRef><bpmn:flowNodeRef>wait</bpmn:flowNodeRef><bpmn:flowNodeRef>end_wait</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet><bpmn:startEvent id="start" name="Accepted return"><bpmn:outgoing>Flow_0</bpmn:outgoing></bpmn:startEvent><bpmn:userTask id="submit" name="Submit idempotent refund command"><bpmn:incoming>Flow_0</bpmn:incoming><bpmn:outgoing>Flow_1</bpmn:outgoing></bpmn:userTask><bpmn:serviceTask id="validate" name="Check actor, state and key"><bpmn:incoming>Flow_1</bpmn:incoming><bpmn:outgoing>Flow_2</bpmn:outgoing></bpmn:serviceTask><bpmn:serviceTask id="pay" name="Create mock payment attempt"><bpmn:incoming>Flow_2</bpmn:incoming><bpmn:outgoing>Flow_3</bpmn:outgoing></bpmn:serviceTask><bpmn:exclusiveGateway id="outcome" name="Payment result?"><bpmn:incoming>Flow_3</bpmn:incoming><bpmn:outgoing>Flow_4</bpmn:outgoing><bpmn:outgoing>Flow_6</bpmn:outgoing><bpmn:outgoing>Flow_8</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:serviceTask id="success" name="Record success / complete return"><bpmn:incoming>Flow_4</bpmn:incoming><bpmn:incoming>Flow_10</bpmn:incoming><bpmn:outgoing>Flow_5</bpmn:outgoing></bpmn:serviceTask><bpmn:endEvent id="end_ok" name="Completed"><bpmn:incoming>Flow_5</bpmn:incoming></bpmn:endEvent><bpmn:userTask id="failed" name="Review definitive failure"><bpmn:incoming>Flow_6</bpmn:incoming><bpmn:incoming>Flow_11</bpmn:incoming><bpmn:outgoing>Flow_7</bpmn:outgoing></bpmn:userTask><bpmn:endEvent id="end_failed" name="Failed / guarded retry available"><bpmn:incoming>Flow_7</bpmn:incoming></bpmn:endEvent><bpmn:userTask id="reconcile" name="Reconcile existing attempt"><bpmn:incoming>Flow_8</bpmn:incoming><bpmn:outgoing>Flow_9</bpmn:outgoing></bpmn:userTask><bpmn:exclusiveGateway id="confirmed" name="Confirmed result?"><bpmn:incoming>Flow_9</bpmn:incoming><bpmn:outgoing>Flow_10</bpmn:outgoing><bpmn:outgoing>Flow_11</bpmn:outgoing><bpmn:outgoing>Flow_12</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:userTask id="wait" name="Keep open / do not resubmit"><bpmn:incoming>Flow_12</bpmn:incoming><bpmn:outgoing>Flow_13</bpmn:outgoing></bpmn:userTask><bpmn:endEvent id="end_wait" name="Pending reconciliation"><bpmn:incoming>Flow_13</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="Flow_0" sourceRef="start" targetRef="submit"/><bpmn:sequenceFlow id="Flow_1" sourceRef="submit" targetRef="validate"/><bpmn:sequenceFlow id="Flow_2" sourceRef="validate" targetRef="pay"/><bpmn:sequenceFlow id="Flow_3" sourceRef="pay" targetRef="outcome"/><bpmn:sequenceFlow id="Flow_4" sourceRef="outcome" targetRef="success" name="SUCCEEDED"/><bpmn:sequenceFlow id="Flow_5" sourceRef="success" targetRef="end_ok"/><bpmn:sequenceFlow id="Flow_6" sourceRef="outcome" targetRef="failed" name="FAILED"/><bpmn:sequenceFlow id="Flow_7" sourceRef="failed" targetRef="end_failed"/><bpmn:sequenceFlow id="Flow_8" sourceRef="outcome" targetRef="reconcile" name="UNKNOWN / PENDING"/><bpmn:sequenceFlow id="Flow_9" sourceRef="reconcile" targetRef="confirmed"/><bpmn:sequenceFlow id="Flow_